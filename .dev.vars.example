# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# Production: `npx wrangler secret put DIRECTORY_API_TOKEN` — never commit real values.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIRECTORY_API_TOKEN=local-dev-token-change-me-0123456789abcdef
